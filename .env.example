# Copy to .env and fill in. Generate secrets with: npm run keys:generate
DATABASE_URL=postgresql://yari:yari@localhost:5432/yari
APP_URL=http://localhost:3000

# Field-level encryption (AES-256-GCM). JSON map of keyId -> base64 32-byte key.
# Keep old keys in the map after rotation until all rows are re-encrypted.
FIELD_ENC_KEYS='{"kdev":"REPLACE_ME_BASE64_32_BYTES"}'
FIELD_ENC_ACTIVE_KEY=kdev
# HMAC key for blind indexes (email / ID lookups) and IP hashing. Never rotate casually:
# changing it requires recomputing every index.
BLIND_INDEX_KEY=REPLACE_ME_BASE64_32_BYTES

# Email (optional in development — emails are printed to the console when unset)
RESEND_API_KEY=
EMAIL_FROM="YARI Academy <academy@yarigroup.co.za>"

# Bootstrap the first Super Admin (used by `npm run db:seed`)
SEED_ADMIN_EMAIL=admin@yarigroup.co.za
SEED_ADMIN_NAME="YARI Admin"
