// YARI Academy — database schema.
// Conventions:
//   *Enc   = AES-256-GCM ciphertext produced by src/server/crypto/field-encryption.ts
//            (AAD binds it to "<Model>.<field>:<rowId>", so rows using encrypted fields
//            get their id generated in application code before insert).
//   *Idx   = HMAC-SHA256 blind index (src/server/crypto/blind-index.ts) used for lookup/uniqueness.
// Phase 1 covers identity, organisations, privacy and audit. Later phases add their own models.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DELETED
}

enum Role {
  SUPER_ADMIN
  TRAINER
  LEARNER
  CLIENT_MANAGER
}

enum IdDocumentType {
  SA_ID
  PASSPORT
}

enum AuthTokenType {
  INVITE
  PASSWORD_RESET
}

enum ConsentPurpose {
  TERMS
  PRIVACY
  MARKETING
}

enum DataRequestType {
  EXPORT
  DELETE
}

enum DataRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum OrganizationStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id            String     @id
  emailEnc      String
  emailIdx      String     @unique
  passwordHash  String?
  status        UserStatus @default(INVITED)
  totpSecretEnc String?
  totpEnabledAt DateTime?
  totpLastStep  Int?
  lastLoginAt   DateTime?
  failedLogins  Int        @default(0)
  lockedUntil   DateTime?
  deletedAt     DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  invitedById   String?
  invitedBy     User?      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees      User[]     @relation("InvitedBy")

  profile             UserProfile?
  roles               RoleAssignment[]
  memberships         OrgMembership[]
  sessions            AuthSession[]
  recoveryCodes       RecoveryCode[]
  authTokens          AuthToken[]
  consents            Consent[]
  dataRequests        DataRequest[]      @relation("DataRequestUser")
  handledRequests     DataRequest[]      @relation("DataRequestHandler")
  courseStaff         CourseStaff[]
  enrolments          Enrolment[]
  uploads             Asset[]
  marks               Mark[]
  gradeOverrides      GradeOverride[]
  sessionsLed         LiveSession[]
  attendance          Attendance[]       @relation("AttendanceLearner")
  attendanceRecorded  Attendance[]       @relation("AttendanceRecorder")
  ratingsReceived     TrainerRating[]    @relation("RatedTrainer")
  ratingsGiven        TrainerRating[]    @relation("Rater")
  announcements       Announcement[]
  threads             DiscussionThread[]
  posts               DiscussionPost[]
  notifications       Notification[]
  badges              UserBadge[]
  certificates        Certificate[]      @relation("CertificateHolder")
  certificatesRevoked Certificate[]      @relation("CertificateRevoker")
  enquiriesHandled    Enquiry[]          @relation("EnquiryHandler")
  orgInvitations      OrgInvitation[]    @relation("OrgInvitationUser")
  orgInvitesSent      OrgInvitation[]    @relation("OrgInvitationSender")
}

model UserProfile {
  userId           String          @id
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullNameEnc      String
  preferredNameEnc String?
  idType           IdDocumentType?
  idNumberEnc      String?
  idNumberIdx      String?         @unique
  passportCountry  String?         @db.Char(2)
  phoneEnc         String?
  addressEnc       String?
  employerEnc      String?
  updatedAt        DateTime        @updatedAt
}

model RoleAssignment {
  id             String        @id @default(cuid(2))
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role
  // Required for CLIENT_MANAGER (the company they manage); null for platform-wide roles.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())

  @@unique([userId, role, organizationId])
  @@index([organizationId, role])
}

model Organization {
  id          String             @id @default(cuid(2))
  name        String
  slug        String             @unique
  regNumber   String?
  status      OrganizationStatus @default(ACTIVE)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  members     OrgMembership[]
  roles       RoleAssignment[]
  enrolments  Enrolment[]
  invitations OrgInvitation[]
}

model OrgMembership {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  employeeRefEnc String?
  department     String?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

model AuthSession {
  // id is the SHA-256 hash of the cookie token; the raw token is never stored.
  id                String   @id
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt         DateTime
  twoFactorVerified Boolean  @default(false)
  ipHash            String?
  userAgent         String?
  createdAt         DateTime @default(now())

  @@index([userId])
}

model RecoveryCode {
  id        String    @id @default(cuid(2))
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model AuthToken {
  // id is the SHA-256 hash of the emailed token.
  id        String        @id
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

model RateLimitHit {
  id  String   @id @default(cuid(2))
  key String
  at  DateTime @default(now())

  @@index([key, at])
}

model Consent {
  id            String         @id @default(cuid(2))
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose       ConsentPurpose
  policyVersion String
  grantedAt     DateTime       @default(now())
  withdrawnAt   DateTime?

  @@index([userId, purpose])
}

model DataRequest {
  id          String            @id @default(cuid(2))
  userId      String
  user        User              @relation("DataRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  type        DataRequestType
  status      DataRequestStatus @default(PENDING)
  note        String?
  handledById String?
  handledBy   User?             @relation("DataRequestHandler", fields: [handledById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  completedAt DateTime?

  @@index([status])
}

// Append-only: a database trigger (see migration) rejects UPDATE and DELETE.
model AuditLog {
  id         String   @id @default(cuid(2))
  actorId    String?
  action     String
  entityType String
  entityId   String?
  fields     String[]
  orgId      String?
  meta       Json?
  ipHash     String?
  at         DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([at])
}

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Phase 2 — Content
// ---------------------------------------------------------------------------

enum CourseCategory {
  HEALTH_SAFETY
  AI_DIGITAL
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseVisibility {
  // Listed in the public catalogue (Phase 6).
  PUBLIC
  // Reachable only by enrolment.
  PRIVATE
}

enum CourseStaffRole {
  LEAD
  ASSISTANT
}

enum ItemType {
  VIDEO
  PDF
  SLIDES
  RICH_TEXT
  LINK
  DOWNLOAD
  QUIZ
  ASSIGNMENT
}

enum ReleaseRuleType {
  AFTER_DATE
  ITEM_COMPLETED
  MIN_SCORE
}

enum AssetScanStatus {
  PENDING
  CLEAN
  INFECTED
  FAILED
  // Development only: no virus scanner configured. Refused in production.
  SKIPPED
}

enum AssetKind {
  DOCUMENT
  VIDEO
  IMAGE
  AUDIO
  FILE
}

enum EnrolmentStatus {
  ACTIVE
  COMPLETED
  WITHDRAWN
}

enum EnrolmentSource {
  ADMIN
  TRAINER
  CLIENT_MANAGER
  SELF
  PURCHASE
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model Course {
  id               String           @id @default(cuid(2))
  slug             String           @unique
  title            String
  summary          String           @default("")
  category         CourseCategory
  status           CourseStatus     @default(DRAFT)
  visibility       CourseVisibility @default(PRIVATE)
  isTemplate       Boolean          @default(false)
  templateSourceId String?
  templateSource   Course?          @relation("TemplateSource", fields: [templateSourceId], references: [id], onDelete: SetNull)
  derivedCourses   Course[]         @relation("TemplateSource")
  coverAssetId     String?
  coverAsset       Asset?           @relation("CourseCover", fields: [coverAssetId], references: [id], onDelete: SetNull)
  estMinutes       Int?
  // Unit standards, NQF level and credits. Only printed on certificates once platform
  // accreditation is switched on (see src/lib/certificates.ts); ignored until then.
  accreditation    Json?
  // Reserved for future payments (out of scope for now).
  priceCents       Int?
  currency         String?          @db.Char(3)
  publishedAt      DateTime?
  createdById      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  staff         CourseStaff[]
  modules       Module[]
  enrolments    Enrolment[]
  questionBanks QuestionBank[]
  rubrics       Rubric[]
  sessions      LiveSession[]
  atRiskRules   AtRiskRule[]
  ratings       TrainerRating[]
  announcements Announcement[]
  threads       DiscussionThread[]
  badges        UserBadge[]
  certificates  Certificate[]
  enquiries     Enquiry[]

  @@index([status, isTemplate])
}

model CourseStaff {
  courseId  String
  course    Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      CourseStaffRole @default(ASSISTANT)
  createdAt DateTime        @default(now())

  @@id([courseId, userId])
  @@index([userId])
}

model Module {
  id           String        @id @default(cuid(2))
  courseId     String
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  position     Int
  title        String
  description  String        @default("")
  items        Item[]
  releaseRules ReleaseRule[] @relation("ModuleRules")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([courseId, position])
}

model Item {
  id           String          @id @default(cuid(2))
  moduleId     String
  module       Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  position     Int
  type         ItemType
  title        String
  // Tiptap JSON for RICH_TEXT; optional intro text for other types.
  body         Json?
  assetId      String?
  asset        Asset?          @relation(fields: [assetId], references: [id], onDelete: SetNull)
  externalUrl  String?
  required     Boolean         @default(true)
  // New items start hidden so half-built content never reaches learners.
  published    Boolean         @default(false)
  estMinutes   Int?
  releaseRules ReleaseRule[]   @relation("ItemRules")
  dependents   ReleaseRule[]   @relation("RuleDependency")
  progress     ItemProgress[]
  quiz         Quiz?
  assignment   Assignment?
  overrides    GradeOverride[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([moduleId, position])
  @@index([assetId])
}

// Attached to either a module or an item. All rules on a target must pass (AND).
model ReleaseRule {
  id              String          @id @default(cuid(2))
  moduleId        String?
  module          Module?         @relation("ModuleRules", fields: [moduleId], references: [id], onDelete: Cascade)
  itemId          String?
  item            Item?           @relation("ItemRules", fields: [itemId], references: [id], onDelete: Cascade)
  type            ReleaseRuleType
  afterDate       DateTime?
  dependsOnItemId String?
  dependsOnItem   Item?           @relation("RuleDependency", fields: [dependsOnItemId], references: [id], onDelete: Cascade)
  minScorePct     Int?
  createdAt       DateTime        @default(now())

  @@index([moduleId])
  @@index([itemId])
}

model Asset {
  id              String           @id @default(cuid(2))
  storageKey      String           @unique
  filename        String
  mime            String
  kind            AssetKind
  // Declared size at upload time; verified against the stored object before release.
  bytes           Int
  sha256          String?
  scanStatus      AssetScanStatus  @default(PENDING)
  scanDetail      String?
  scannedAt       DateTime?
  uploadedById    String?
  uploadedBy      User?            @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  items           Item[]
  coverOf         Course[]         @relation("CourseCover")
  submissionFiles SubmissionFile[]
  feedbackFor     Mark[]           @relation("MarkFeedbackFile")
  audioFor        Mark[]           @relation("MarkAudio")

  @@index([uploadedById])
}

model Enrolment {
  id             String          @id @default(cuid(2))
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // The company that enrolled the learner (drives Client Manager reporting).
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  source         EnrolmentSource
  status         EnrolmentStatus @default(ACTIVE)
  enrolledById   String?
  dueAt          DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  lastActiveAt   DateTime?
  progressPct    Int             @default(0)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  progress       ItemProgress[]
  quizAttempts   QuizAttempt[]
  submissions    Submission[]
  overrides      GradeOverride[]
  atRiskFlags    AtRiskFlag[]
  certificates   Certificate[]

  @@unique([userId, courseId])
  @@index([courseId, status])
  @@index([organizationId])
}

model ItemProgress {
  id            String         @id @default(cuid(2))
  enrolmentId   String
  enrolment     Enrolment      @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  itemId        String
  item          Item           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  status        ProgressStatus @default(NOT_STARTED)
  firstViewedAt DateTime?
  lastViewedAt  DateTime?
  completedAt   DateTime?
  timeSpentSec  Int            @default(0)
  // Best score for scored items (quizzes, Phase 3). Used by MIN_SCORE release rules.
  scorePct      Float?

  @@unique([enrolmentId, itemId])
  @@index([itemId])
}

// ---------------------------------------------------------------------------
// Phase 3 — Assessment
// ---------------------------------------------------------------------------

enum QuestionType {
  MCQ
  MULTI_SELECT
  TRUE_FALSE
  SHORT_ANSWER
  MATCHING
}

enum ShowAnswers {
  NEVER
  AFTER_SUBMIT
  AFTER_PASS
}

enum AttemptStatus {
  IN_PROGRESS
  // Short answers that didn't match an accepted answer wait for a trainer.
  NEEDS_MARKING
  MARKED
}

enum SubmissionStatus {
  SUBMITTED
  MARKED
  // Trainer asked the learner to resubmit.
  RETURNED
}

enum MarkStatus {
  DRAFT
  RELEASED
}

model QuestionBank {
  id        String        @id @default(cuid(2))
  courseId  String
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  questions Question[]
  sections  QuizSection[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([courseId])
}

model Question {
  id          String       @id @default(cuid(2))
  bankId      String
  bank        QuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)
  type        QuestionType
  prompt      String
  // Shape depends on type (see src/lib/questions.ts). Never sent to learners as-is.
  options     Json
  answerKey   Json
  points      Int          @default(1)
  explanation String?
  position    Int
  // Archived instead of deleted, so past attempts keep making sense.
  archived    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([bankId, archived, position])
}

model Quiz {
  itemId       String        @id
  item         Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  instructions String        @default("")
  passPct      Int           @default(70)
  timeLimitMin Int?
  maxAttempts  Int?
  shuffle      Boolean       @default(true)
  showAnswers  ShowAnswers   @default(AFTER_SUBMIT)
  sections     QuizSection[]
  attempts     QuizAttempt[]
}

// Draws `drawCount` random questions from a bank (all of them when null).
model QuizSection {
  id        String       @id @default(cuid(2))
  quizId    String
  quiz      Quiz         @relation(fields: [quizId], references: [itemId], onDelete: Cascade)
  bankId    String
  bank      QuestionBank @relation(fields: [bankId], references: [id], onDelete: Cascade)
  drawCount Int?
  position  Int

  @@index([quizId])
}

model QuizAttempt {
  id          String        @id @default(cuid(2))
  quizId      String
  quiz        Quiz          @relation(fields: [quizId], references: [itemId], onDelete: Cascade)
  enrolmentId String
  enrolment   Enrolment     @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  attemptNo   Int
  // Snapshot of the drawn questions, including the answer key (server-side only).
  questions   Json
  answers     Json          @default("{}")
  // Points per question id (auto-marked, then adjusted by a trainer for short answers).
  awarded     Json          @default("{}")
  scorePct    Float?
  passed      Boolean?
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  deadline    DateTime?
  submittedAt DateTime?
  markedById  String?
  markedAt    DateTime?

  @@unique([quizId, enrolmentId, attemptNo])
  @@index([enrolmentId])
  @@index([quizId, status])
}

model Rubric {
  id          String            @id @default(cuid(2))
  courseId    String
  course      Course            @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  criteria    RubricCriterion[]
  assignments Assignment[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([courseId])
}

model RubricCriterion {
  id          String        @id @default(cuid(2))
  rubricId    String
  rubric      Rubric        @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  position    Int
  title       String
  description String        @default("")
  levels      RubricLevel[]
}

model RubricLevel {
  id          String          @id @default(cuid(2))
  criterionId String
  criterion   RubricCriterion @relation(fields: [criterionId], references: [id], onDelete: Cascade)
  position    Int
  label       String
  points      Int
  description String          @default("")
}

model Assignment {
  itemId      String       @id
  item        Item         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  dueAt       DateTime?
  allowText   Boolean      @default(true)
  allowFiles  Boolean      @default(true)
  maxFiles    Int          @default(3)
  // When a rubric is attached, maxPoints follows the rubric's total.
  maxPoints   Int          @default(100)
  passPct     Int          @default(50)
  rubricId    String?
  rubric      Rubric?      @relation(fields: [rubricId], references: [id], onDelete: SetNull)
  allowLate   Boolean      @default(true)
  submissions Submission[]
}

model Submission {
  id           String           @id @default(cuid(2))
  assignmentId String
  assignment   Assignment       @relation(fields: [assignmentId], references: [itemId], onDelete: Cascade)
  enrolmentId  String
  enrolment    Enrolment        @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  attemptNo    Int
  text         String?
  status       SubmissionStatus @default(SUBMITTED)
  isLate       Boolean          @default(false)
  submittedAt  DateTime         @default(now())
  files        SubmissionFile[]
  mark         Mark?

  @@unique([assignmentId, enrolmentId, attemptNo])
  @@index([enrolmentId])
  @@index([assignmentId, status])
}

model SubmissionFile {
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  assetId      String
  asset        Asset      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  position     Int

  @@id([submissionId, assetId])
  @@index([assetId])
}

model Mark {
  id               String     @id @default(cuid(2))
  submissionId     String     @unique
  submission       Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  graderId         String?
  grader           User?      @relation(fields: [graderId], references: [id], onDelete: SetNull)
  score            Float
  // criterionId -> levelId
  rubricSelections Json       @default("{}")
  feedbackText     String?
  feedbackAssetId  String?
  feedbackAsset    Asset?     @relation("MarkFeedbackFile", fields: [feedbackAssetId], references: [id], onDelete: SetNull)
  audioAssetId     String?
  audioAsset       Asset?     @relation("MarkAudio", fields: [audioAssetId], references: [id], onDelete: SetNull)
  status           MarkStatus @default(DRAFT)
  releasedAt       DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([feedbackAssetId])
  @@index([audioAssetId])
}

// A trainer's manual grade for one learner on one assessed item. Replaces the computed grade.
model GradeOverride {
  id          String    @id @default(cuid(2))
  enrolmentId String
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  scorePct    Float
  reason      String
  graderId    String?
  grader      User?     @relation(fields: [graderId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([enrolmentId, itemId])
}

// ---------------------------------------------------------------------------
// Phase 4 — Tracking
// ---------------------------------------------------------------------------

enum SessionMode {
  IN_PERSON
  ONLINE
  HYBRID
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED
}

enum AttendanceMethod {
  QR
  ONLINE_JOIN
  MANUAL
}

enum AtRiskType {
  INACTIVE_DAYS
  MISSED_DEADLINE
  SCORE_BELOW
}

model LiveSession {
  id          String          @id @default(cuid(2))
  courseId    String
  course      Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String          @default("")
  mode        SessionMode
  startsAt    DateTime
  endsAt      DateTime
  location    String?
  meetingUrl  String?
  trainerId   String?
  trainer     User?           @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  // Server-side secret for the rotating check-in QR code. Never sent to browsers.
  qrSecret    String
  cancelledAt DateTime?
  attendance  Attendance[]
  ratings     TrainerRating[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([courseId, startsAt])
  @@index([startsAt])
}

model Attendance {
  id           String           @id @default(cuid(2))
  sessionId    String
  session      LiveSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation("AttendanceLearner", fields: [userId], references: [id], onDelete: Cascade)
  status       AttendanceStatus
  method       AttendanceMethod
  checkedInAt  DateTime?
  recordedById String?
  recordedBy   User?            @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  note         String?
  updatedAt    DateTime         @updatedAt

  @@unique([sessionId, userId])
  @@index([userId])
}

// One rule of each type per course; the threshold means days (INACTIVE_DAYS, MISSED_DEADLINE grace)
// or a percentage (SCORE_BELOW).
model AtRiskRule {
  id          String       @id @default(cuid(2))
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  type        AtRiskType
  threshold   Int
  active      Boolean      @default(true)
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  flags       AtRiskFlag[]

  @@unique([courseId, type])
}

model AtRiskFlag {
  id               String     @id @default(cuid(2))
  ruleId           String
  rule             AtRiskRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  enrolmentId      String
  enrolment        Enrolment  @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  reason           String
  raisedAt         DateTime   @default(now())
  resolvedAt       DateTime?
  // true when a trainer dismissed it (suppresses re-raising for a while); false when it cleared itself.
  resolvedManually Boolean    @default(false)
  resolvedById     String?
  note             String?
  // Set when the new-flag email digest included this flag.
  notifiedAt       DateTime?

  @@index([enrolmentId])
  @@index([ruleId, enrolmentId, resolvedAt])
}

// ---------------------------------------------------------------------------
// Phase 5 — Engagement
// ---------------------------------------------------------------------------

enum AnnouncementScope {
  PLATFORM
  COURSE
}

enum NotificationType {
  ANNOUNCEMENT
  DISCUSSION_REPLY
  DISCUSSION_THREAD
  MARK_RELEASED
  BADGE
  CERTIFICATE
  ENQUIRY
  COMPANY_INVITE
}

// A learner's rating of one trainer, for a course (sessionId null) or a session.
// Trainers only ever see aggregates; see src/server/engagement/ratings.ts.
model TrainerRating {
  id         String       @id @default(cuid(2))
  trainerId  String
  trainer    User         @relation("RatedTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  raterId    String?
  rater      User?        @relation("Rater", fields: [raterId], references: [id], onDelete: SetNull)
  courseId   String
  course     Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sessionId  String?
  session    LiveSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  knowledge  Int
  clarity    Int
  relevance  Int
  engagement Int
  comment    String?
  createdAt  DateTime     @default(now())

  @@index([trainerId, createdAt])
  @@index([raterId])
}

model Announcement {
  id         String            @id @default(cuid(2))
  scope      AnnouncementScope
  courseId   String?
  course     Course?           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  title      String
  body       Json
  pinned     Boolean           @default(false)
  emailed    Boolean           @default(false)
  recipients Int               @default(0)
  createdAt  DateTime          @default(now())

  @@index([scope, createdAt])
  @@index([courseId, createdAt])
}

model DiscussionThread {
  id         String           @id @default(cuid(2))
  courseId   String
  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  authorId   String?
  author     User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  title      String
  pinned     Boolean          @default(false)
  locked     Boolean          @default(false)
  lastPostAt DateTime         @default(now())
  posts      DiscussionPost[]
  createdAt  DateTime         @default(now())

  @@index([courseId, pinned, lastPostAt])
}

model DiscussionPost {
  id          String           @id @default(cuid(2))
  threadId    String
  thread      DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId    String?
  author      User?            @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body        String
  editedAt    DateTime?
  // Soft delete keeps the conversation readable ("removed by a trainer").
  deletedAt   DateTime?
  deletedById String?
  createdAt   DateTime         @default(now())

  @@index([threadId, createdAt])
}

model Notification {
  id        String           @id @default(cuid(2))
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  href      String
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt, createdAt])
}

// Badge definitions live in code (src/lib/badges.ts); this records who earned what.
model UserBadge {
  id        String   @id @default(cuid(2))
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     String
  // Set for course-specific badges (e.g. full marks on a course's quiz).
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Phase 6: certificates and the public site
// ---------------------------------------------------------------------------

// A Certificate of Completion. Everything printed on it is frozen at issue time, so it reads
// the same years later even if the course is renamed. One active certificate per enrolment
// (partial unique index in the migration).
model Certificate {
  id              String         @id @default(cuid(2))
  // Public verification code, e.g. YG-7K3M-Q9TP.
  code            String         @unique
  enrolmentId     String?
  enrolment       Enrolment?     @relation(fields: [enrolmentId], references: [id], onDelete: SetNull)
  userId          String?
  user            User?          @relation("CertificateHolder", fields: [userId], references: [id], onDelete: SetNull)
  courseId        String?
  course          Course?        @relation(fields: [courseId], references: [id], onDelete: SetNull)
  // AES-GCM JSON { learnerName, trainers[] }, bound to the code. Erased if the holder's account is.
  holderEnc       String?
  courseTitle     String
  category        CourseCategory
  durationMinutes Int?
  completedAt     DateTime
  issuedAt        DateTime       @default(now())
  // Accreditation printed on this certificate; null = not accredited (the disclaimer is printed).
  accreditation   Json?
  revokedAt       DateTime?
  revokedById     String?
  revokedBy       User?          @relation("CertificateRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  revokeReason    String?

  @@index([userId])
  @@index([courseId])
}

enum EnquiryInterest {
  SHE
  TECH
  BOTH
}

enum EnquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

// From the public enquiry form. Contact details and the message are encrypted; enquiries are
// deleted 12 months after they are closed or last updated (nightly job).
model Enquiry {
  id          String          @id @default(cuid(2))
  nameEnc     String
  emailEnc    String
  phoneEnc    String?
  company     String?
  interest    EnquiryInterest
  courseId    String?
  course      Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  messageEnc  String
  consentAt   DateTime
  status      EnquiryStatus   @default(NEW)
  handledById String?
  handledBy   User?           @relation("EnquiryHandler", fields: [handledById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status, createdAt])
}

// A company's request to add someone who already has an account. Nothing about that person is
// visible to the company, and no role or membership is granted, until they accept.
model OrgInvitation {
  id             String       @id @default(cuid(2))
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation("OrgInvitationUser", fields: [userId], references: [id], onDelete: Cascade)
  invitedById    String?
  invitedBy      User?        @relation("OrgInvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)
  department     String?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}
